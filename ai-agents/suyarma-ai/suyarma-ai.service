[Unit]
Description=KIRAT OS — Oracle AI (Predictive Patching & CVE Intelligence)
After=network-online.target

[Service]
Type=simple
User=suyarma-ai
Group=ai-agents
WorkingDirectory=/opt/kirat-os/ai-agents/suyarma-ai
Environment="PYTHONPATH=/opt/kirat-os/ai-agents"
Environment="KIRAT_OS_ENABLE_DESTRUCTIVE_ACTIONS=false"
ExecStart=/usr/bin/python3 /opt/kirat-os/ai-agents/suyarma-ai/main.py
Restart=always
RestartSec=10

LimitNOFILE=65536
MemoryMax=512M
CPUQuota=50%

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kirat-os /var/cache/kirat-os /etc/apt

[Install]
WantedBy=multi-user.target
