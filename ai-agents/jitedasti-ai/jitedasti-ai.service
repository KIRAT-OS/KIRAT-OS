[Unit]
Description=KIRAT OS — Hunter AI (Autonomous Threat Hunting)
After=network-online.target ollama.service auditd.service
Wants=ollama.service

[Service]
Type=simple
User=jitedasti-ai
Group=ai-agents
WorkingDirectory=/opt/kirat-os/ai-agents/jitedasti-ai
Environment="PYTHONPATH=/opt/kirat-os/ai-agents"
Environment="OLLAMA_HOST=http://localhost:11434"
ExecStart=/usr/bin/python3 /opt/kirat-os/ai-agents/jitedasti-ai/main.py
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

LimitNOFILE=65536
MemoryMax=1G
CPUQuota=100%

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kirat-os

[Install]
WantedBy=multi-user.target
