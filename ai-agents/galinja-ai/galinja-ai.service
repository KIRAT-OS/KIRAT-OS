[Unit]
Description=KIRAT OS — Healer AI (Self-Healing & Incident Response)
After=network-online.target jitedasti-ai.service
Wants=jitedasti-ai.service

[Service]
Type=simple
User=galinja-ai
Group=ai-agents
WorkingDirectory=/opt/kirat-os/ai-agents/galinja-ai
Environment="PYTHONPATH=/opt/kirat-os/ai-agents"
Environment="KIRAT_OS_ENABLE_DESTRUCTIVE_ACTIONS=false"
ExecStart=/opt/kirat-os/venv/bin/python /opt/kirat-os/ai-agents/galinja-ai/main.py
Restart=always
RestartSec=10

LimitNOFILE=65536
MemoryMax=512M
CPUQuota=50%

# Sudo is restricted to the canonical signed executor in sudoers.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kirat-os /data/forensics
[Install]
WantedBy=multi-user.target
