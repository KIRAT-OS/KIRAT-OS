[Unit]
Description=KIRAT OS — Deception AI (Honeypots & Attacker Trapping)
After=network-online.target

[Service]
Type=simple
User=oysgja-ai
Group=ai-agents
WorkingDirectory=/opt/kirat-os/ai-agents/oysgja-ai
Environment="PYTHONPATH=/opt/kirat-os/ai-agents"
ExecStart=/opt/kirat-os/venv/bin/python /opt/kirat-os/ai-agents/oysgja-ai/main.py
Restart=always
RestartSec=10

LimitNOFILE=65536
MemoryMax=256M
CPUQuota=50%

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kirat-os /tmp

[Install]
WantedBy=multi-user.target
